#!/bin/sh

# Get the absolute path of the script directory
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SHELFFILES="$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)"
export SHELFFILES

# Source the environment setup
. "$SCRIPT_DIR/env.sh"

mkdir -p "$XDG_STATE_HOME"/bash
export HISTFILE="$XDG_STATE_HOME"/bash/history

# Execute bash
if [ "${shelffiles_portable_active:-0}" != 1 ] && [ ! -e "$SHELFFILES/result" ] ; then
    echo "Error: $SHELFFILES/result is missing. Run ./setup.sh, or start an exported copy with portable/entrypoint/bash." >&2
    exit 1
fi
exec bash --init-file "$XDG_CONFIG_HOME"/bash/.bashrc "$@"
