#!/bin/sh

# Get the absolute path of the script directory
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
SHELFFILES="$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)"
export SHELFFILES

# Source the environment setup
. "$SCRIPT_DIR/env.sh"

# Set ZDOTDIR if not already set
[ -z "$ZDOTDIR" ] && export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Workaround for vscode shell integration
export USER_ZDOTDIR="$ZDOTDIR"

# Execute zsh
if [ "${shelffiles_portable_active:-0}" != 1 ] && [ ! -e "$SHELFFILES/result" ] ; then
    echo "Error: $SHELFFILES/result is missing. Run ./setup.sh, or start an exported copy with portable/entrypoint/zsh." >&2
    exit 1
fi
exec zsh "$@"
